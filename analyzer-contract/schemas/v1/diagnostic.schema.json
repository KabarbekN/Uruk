{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semanticmap.io/schemas/v1/diagnostic.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["code", "severity", "message", "filePath", "startLine", "metadata"],
  "properties": {"code": {"type": "string", "minLength": 1}, "severity": {"enum": ["INFO", "WARNING", "ERROR", "FATAL"]}, "message": {"type": "string"}, "filePath": {"type": ["string", "null"]}, "startLine": {"type": ["integer", "null"], "minimum": 1}, "metadata": {"type": "object", "additionalProperties": true}}
}
