{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semanticmap.io/schemas/v1/fact.schema.json",
  "title": "Analyzer fact v1",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "factId", "kind", "stableKey", "subject", "properties", "origin", "confidence", "evidence"],
  "properties": {
    "contractVersion": {"const": "1.0"},
    "factId": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "stableKey": {"type": "string", "minLength": 1},
    "subject": {"type": "object", "additionalProperties": false, "required": ["kind", "stableKey"], "properties": {"kind": {"type": "string", "minLength": 1}, "stableKey": {"type": "string", "minLength": 1}}},
    "properties": {"type": "object", "additionalProperties": true},
    "origin": {"enum": ["STATIC_EXACT", "STATIC_TYPED", "STATIC_SYNTAX", "FRAMEWORK_DERIVED", "DATABASE_DERIVED", "RUNTIME_OBSERVED", "HEURISTIC"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["filePath", "startLine", "startColumn", "endLine", "endColumn", "snippetHash"], "properties": {"filePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}, "startLine": {"type": "integer", "minimum": 1}, "startColumn": {"type": "integer", "minimum": 1}, "endLine": {"type": "integer", "minimum": 1}, "endColumn": {"type": "integer", "minimum": 1}, "snippetHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}
  },
  "allOf": [{"if": {"properties": {"kind": {"const": "RELATION"}}}, "then": {"properties": {"properties": {"required": ["sourceKey", "targetKey", "edgeKind"], "properties": {"sourceKey": {"type": "string", "minLength": 1}, "targetKey": {"type": "string", "minLength": 1}, "edgeKind": {"type": "string", "minLength": 1}}}}}}]
}
