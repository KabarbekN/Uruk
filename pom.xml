<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>io.semanticmap</groupId><artifactId>semantic-business-map</artifactId><version>0.1.0-SNAPSHOT</version><packaging>pom</packaging>
  <modules><module>analyzer-contract</module><module>analyzers/java-spring</module><module>backend/platform</module></modules>
  <properties><java.version>21</java.version><spring-modulith.version>1.4.13</spring-modulith.version><spring-ai.version>1.1.6</spring-ai.version><postgresql.version>42.7.12</postgresql.version><rewrite.version>8.87.7</rewrite.version><commons-lang3.version>3.20.0</commons-lang3.version><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
